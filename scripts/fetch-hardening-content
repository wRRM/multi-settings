#!/bin/sh
set -eu

version=10.6.0
archive="devsec-hardening-${version}.tar.gz"
download_url="https://galaxy.ansible.com/api/v3/plugin/ansible/content/published/collections/artifacts/${archive}"
script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname -- "${script_directory}")

cd "${project_root}"

mkdir -p vendor
expected_sha256=$(awk 'NF == 2 { print $1 }' "data/ansible/devsec-hardening-${version}.sha256")

verify_archive() {
  actual_sha256=$(sha256sum -- "$1" | awk '{ print $1 }')
  if [ "${actual_sha256}" != "${expected_sha256}" ]; then
    echo "Checksum verification failed for $1" >&2
    return 1
  fi
}

if [ "$#" -gt 1 ]; then
  echo "Usage: $0 [${archive}]" >&2
  exit 64
fi

if [ -f "vendor/${archive}" ] && verify_archive "vendor/${archive}"; then
  echo "Reusing verified vendor/${archive}."
  exit 0
fi

if [ "$#" -eq 1 ]; then
  source_archive=$1
  if [ ! -f "${source_archive}" ]; then
    echo "Imported collection archive not found: ${source_archive}" >&2
    exit 66
  fi
  verify_archive "${source_archive}"
  cp -- "${source_archive}" "vendor/${archive}.partial"
else
  curl --fail --location --proto '=https' --tlsv1.2 \
    --output "vendor/${archive}.partial" "${download_url}"
fi

verify_archive "vendor/${archive}.partial"
mv "vendor/${archive}.partial" "vendor/${archive}"
echo "Imported and verified ${archive}."
